# Dev local: o app usa proxy /api/guto → backend (sem CORS no browser).
# Suba o backend: cd guto-backend && npm run dev  (porta 3001)
GUTO_BACKEND_PROXY_URL=http://localhost:3001
NEXT_PUBLIC_GUTO_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cutover controlado do CORPO para o contrato minimo do CEREBRO V3.
# Manter false ate Postgres, migracao, Mem0, traces e QA manual estarem aprovados.
NEXT_PUBLIC_GUTO_V3_ENABLED=false
# Preview-only: permite ao painel administrativo usar sua superfície própria.
# Não libera nenhum fallback do Companion.
NEXT_PUBLIC_GUTO_V3_PANEL_ENABLED=false
# Defesa server-side do proxy Preview: rejeita qualquer caminho não-V3.
GUTO_V3_ONLY=false

# Para apontar o proxy local para um backend publicado (sem mudar código):
# GUTO_BACKEND_PROXY_URL=https://cerebroguto-sovereign-smoke-p4jbstvux.vercel.app
# NEXT_PUBLIC_GUTO_API_URL=https://cerebroguto-sovereign-smoke-p4jbstvux.vercel.app
# GUTO_BACKEND_PROXY_URL=https://cerebroguto.onrender.com
# NEXT_PUBLIC_GUTO_API_URL=https://cerebroguto.onrender.com
# NEXT_PUBLIC_API_URL=https://cerebroguto.onrender.com
